rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the one calendar document, only advent-shaped data
    match /calendar/{id} {
      allow read: if id.matches('advent-[a-f0-9]{24}');
      allow write: if id.matches('advent-[a-f0-9]{24}')
        && request.resource.data.keys().hasOnly(['v','days','plan','updatedAt']);
    }
  }
}
